generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model HttpSession {
  id_hash    String   @id @db.Char(64)
  csrf_token String
  expires_at DateTime @db.Timestamptz(3)

  account_id String?  @db.Uuid
  account    Account? @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@index([account_id])
  @@index([expires_at])
  @@map("http_session")
}

enum Role {
  student
  organizer
  reviewer
  tech_admin
}

enum MemberRole {
  owner
  collaborator
}

model Account {
  id                   String           @id @default(uuid()) @db.Uuid
  username             String           @unique
  display_name         String
  password_hash        String
  must_change_password Boolean          @default(true)
  active               Boolean          @default(true)
  roles                RoleGrant[]
  sessions             HttpSession[]
  members              ActivityMember[]
  student              Student?

  @@map("account")
}

model Student {
  hour_records HourRecord[]
  registrations Registration[]
  receipts      NoticeReceipt[]
  id            String         @id @default(uuid()) @db.Uuid
  account_id    String         @unique @db.Uuid
  student_no    String         @unique @db.Char(10)
  version       Int            @default(1)
  cohort        String?
  grade         String?
  class_name    String?
  college       String?
  created_at    DateTime       @default(now()) @db.Timestamptz(3)
  updated_at    DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  account       Account        @relation(fields: [account_id], references: [id])

  @@map("student")
}

model StudentImportBatch {
  id            String             @id @default(uuid()) @db.Uuid
  version       Int                @default(1)
  status        String             @default("validating")
  source_hash   String
  source_name   String
  source_data   Bytes
  row_count     Int                @default(0)
  created_count Int                @default(0)
  skipped_count Int                @default(0)
  error_count   Int                @default(0)
  error_message String?
  created_by    String             @db.Uuid
  created_at    DateTime           @default(now()) @db.Timestamptz(3)
  updated_at    DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  rows          StudentImportRow[]

  @@index([created_by, created_at])
  @@map("student_import_batch")
}

model StudentImportRow {
  batch_id                 String             @db.Uuid
  row_number               Int
  action                   String
  student_no               String?
  name                     String?
  cohort                   String?
  grade                    String?
  class_name               String?
  college                  String?
  raw_values               Json
  errors                   Json
  resulting_account_status String?
  batch                    StudentImportBatch @relation(fields: [batch_id], references: [id], onDelete: Cascade)

  @@id([batch_id, row_number])
  @@map("student_import_row")
}

model RoleGrant {
  account_id String    @db.Uuid
  role       Role
  expires_at DateTime? @db.Timestamptz(3)
  account    Account   @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@id([account_id, role])
  @@map("role_grant")
}

model LoginWindow {
  key        String   @id
  attempts   Int
  expires_at DateTime @db.Timestamptz(3)

  @@index([expires_at])
  @@map("login_window")
}

model Activity {
  hour_batches HourImportBatch[]
  hour_files   HourImportFile[]
  hour_records HourRecord[]
  reviews            ActivityReview[]
  registrations      Registration[]
  notices            Notice[]
  id                 String             @id @default(uuid()) @db.Uuid
  activity_code      String             @unique
  status             String             @default("draft")
  version            Int                @default(1)
  team_version       Int                @default(1)
  working_revision   Int
  published_revision Int?
  members            ActivityMember[]
  revisions          ActivityRevision[]

  @@map("activity")
}

model ActivityRevision {
  activity_id    String    @db.Uuid
  revision       Int
  revision_state String
  content        Json
  created_by     String    @db.Uuid
  created_at     DateTime  @default(now()) @db.Timestamptz(3)
  approved_at    DateTime? @db.Timestamptz(3)
  activity       Activity  @relation(fields: [activity_id], references: [id], onDelete: Cascade)

  @@id([activity_id, revision])
  @@map("activity_revision")
}

model ActivityMember {
  activity_id String     @db.Uuid
  account_id  String     @db.Uuid
  member_role MemberRole
  activity    Activity   @relation(fields: [activity_id], references: [id], onDelete: Cascade)
  account     Account    @relation(fields: [account_id], references: [id])

  @@id([activity_id, account_id])
  @@index([account_id])
  @@map("activity_member")
}

model Registration {
  id              String                @id @default(uuid()) @db.Uuid
  student_id      String                @db.Uuid
  activity_id     String                @db.Uuid
  status          String
  version         Int                   @default(1)
  statement       String?
  decision_reason String?
  history         RegistrationHistory[]
  submitted_at    DateTime              @default(now()) @db.Timestamptz(3)
  student         Student               @relation(fields: [student_id], references: [id])
  activity        Activity              @relation(fields: [activity_id], references: [id])

  @@unique([activity_id, student_id])
  @@index([student_id])
  @@map("registration")
}

model RegistrationHistory {
  registration_id String       @db.Uuid
  version         Int
  status          String
  submitted_at    DateTime     @db.Timestamptz(3)
  statement       String?
  decision_reason String?
  changed_at      DateTime?    @db.Timestamptz(3)
  actor_id        String?      @db.Uuid
  registration    Registration @relation(fields: [registration_id], references: [id])

  @@id([registration_id, version])
  @@map("registration_history")
}

model RegistrationDecisionEvent {
  event_id             String   @id @default(uuid()) @db.Uuid
  event_type           String   @default("registration_decided")
  activity_id          String   @db.Uuid
  registration_id      String   @db.Uuid
  student_id           String   @db.Uuid
  registration_version Int
  status               String
  created_at           DateTime @default(now()) @db.Timestamptz(3)

  @@unique([registration_id, registration_version], map: "registration_decision_version_key")
  @@map("registration_decision_event")
}

model ActivityReview {
  id                String    @id @default(uuid()) @db.Uuid
  activity_id       String    @db.Uuid
  revision          Int
  previous_revision Int?
  version           Int       @default(1)
  status            String    @default("pending")
  submitted_by      String    @db.Uuid
  reviewed_by       String?   @db.Uuid
  reason            String?
  created_at        DateTime  @default(now()) @db.Timestamptz(3)
  reviewed_at       DateTime? @db.Timestamptz(3)
  activity          Activity  @relation(fields: [activity_id], references: [id])

  @@unique([activity_id, revision])
  @@index([status, created_at])
  @@map("activity_review")
}

model CommandReceipt {
  account_id String   @db.Uuid
  method     String
  path       String
  key        String
  digest     String
  response   Json
  created_at DateTime @default(now()) @db.Timestamptz(3)

  @@id([account_id, method, path, key])
  @@map("command_receipt")
}

model ReviewAudit {
  review_id     String   @id @db.Uuid
  activity_id   String   @db.Uuid
  actor_id      String   @db.Uuid
  revision      Int
  before_status String
  after_status  String
  before_public Int?
  after_public  Int?
  reason        String?
  created_at    DateTime @default(now()) @db.Timestamptz(3)

  @@map("review_audit")
}

model ActivityChangeEvent {
  review_id      String   @db.Uuid
  activity_id    String   @db.Uuid
  student_id     String   @db.Uuid
  revision       Int
  changed_fields String[]
  created_at     DateTime @default(now()) @db.Timestamptz(3)

  @@id([review_id, student_id])
  @@map("activity_change_event")
}

// 站内通知。receipts 保存发送时的接收人快照，补发不修改历史接收人。
model Notice {
  id                  String          @id @default(uuid()) @db.Uuid
  version             Int             @default(1)
  activity_id         String          @db.Uuid
  title               String
  body                String
  requires_ack        Boolean         @default(true)
  notice_kind         String
  information_version Int             @default(1)
  source_notice_id    String?         @db.Uuid
  supersedes_id       String?         @db.Uuid
  is_current          Boolean         @default(true)
  published_by        String?         @db.Uuid
  // 一次业务事件最多产出一条通知，重试与并发投递都靠它兜底。
  source_event_id     String?         @unique @db.Uuid
  // 提醒覆盖的版本区间：base_revision 是学生上次被告知的版本，source_revision 是这次通知的依据版本。
  // 迟到的事件按区间重算正文，既能补齐漏发的字段，也不会把更新的提醒顶掉。
  base_revision       Int?
  source_revision     Int?
  published_at        DateTime        @default(now()) @db.Timestamptz(3)
  created_at          DateTime        @default(now()) @db.Timestamptz(3)
  updated_at          DateTime        @updatedAt @db.Timestamptz(3)
  activity            Activity        @relation(fields: [activity_id], references: [id], onDelete: Cascade)
  receipts            NoticeReceipt[]

  // 同一活动的同一类通知版本号唯一，兜住并发投递写坏版本链的情况。
  @@unique([activity_id, notice_kind, information_version])
  @@index([activity_id, notice_kind, is_current])
  @@map("notice")
}

model NoticeReceipt {
  notice_id       String    @db.Uuid
  student_id      String    @db.Uuid
  read_at         DateTime? @db.Timestamptz(3)
  acknowledged_at DateTime? @db.Timestamptz(3)
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  notice          Notice    @relation(fields: [notice_id], references: [id], onDelete: Cascade)
  student         Student   @relation(fields: [student_id], references: [id])

  @@id([notice_id, student_id])
  @@index([student_id])
  @@map("notice_receipt")
}

// 业务事务写入的待发送事件。event_key 保证同一业务事件与接收人只入队一次。
model NotificationEvent {
  id              String    @id @default(uuid()) @db.Uuid
  version         Int       @default(1)
  event_type      String
  event_key       String    @unique
  activity_id     String?   @db.Uuid
  resource_id     String?   @db.Uuid
  source_revision Int?
  payload         Json
  status          String    @default("pending")
  attempt_count   Int       @default(0)
  last_error      String?
  last_retry_reason String?
  next_retry_at   DateTime? @db.Timestamptz(3)
  delivered_at    DateTime? @db.Timestamptz(3)
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  updated_at      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([status, next_retry_at])
  @@map("notification_event")
}

model HourImportFile {
  id           String   @id @default(uuid()) @db.Uuid
  activity_id  String   @db.Uuid
  name         String
  purpose      String
  size         Int
  contents     Bytes
  created_at   DateTime @default(now()) @db.Timestamptz(3)
  activity     Activity @relation(fields: [activity_id], references: [id])
  sources      HourImportBatch[] @relation("HourSource")
  reports      HourImportBatch[] @relation("HourReport")

  @@map("hour_import_file")
}

model HourImportBatch {
  id             String   @id @default(uuid()) @db.Uuid
  activity_id    String   @db.Uuid
  source_file_id String   @db.Uuid
  report_file_id String?  @db.Uuid
  submitted_by   String   @db.Uuid
  validation_by  String   @db.Uuid
  mode           String
  status         String   @default("validating")
  version        Int      @default(1)
  retry_count    Int      @default(0)
  created_at     DateTime @default(now()) @db.Timestamptz(3)
  updated_at     DateTime @updatedAt @db.Timestamptz(3)
  metadata       Json
  summary        Json
  activity       Activity @relation(fields: [activity_id], references: [id])
  source         HourImportFile @relation("HourSource", fields: [source_file_id], references: [id])
  report         HourImportFile? @relation("HourReport", fields: [report_file_id], references: [id])
  rows           HourImportRow[]

  @@index([activity_id, created_at, id])
  @@index([status, created_at])
  @@map("hour_import_batch")
}

model HourImportRow {
  batch_id    String @db.Uuid
  row_number  Int
  action      String
  needs_review Boolean
  detail      Json
  batch       HourImportBatch @relation(fields: [batch_id], references: [id], onDelete: Cascade)

  @@id([batch_id, row_number])
  @@map("hour_import_row")
}

model HourRecord {
  id                       String   @id @default(uuid()) @db.Uuid
  student_id               String   @db.Uuid
  activity_id              String   @db.Uuid
  service_date             DateTime @db.Date
  version                  Int
  status                   String
  hours                    Decimal  @db.Decimal(4, 1)
  origin_schedule_revision Int
  misconduct_reported      String
  misconduct_version       Int
  misconduct_fact          String?
  reusable_facts           String[] @default([])
  student                  Student  @relation(fields: [student_id], references: [id])
  activity                 Activity @relation(fields: [activity_id], references: [id])

  @@unique([student_id, service_date, activity_id])
  @@map("hour_record")
}