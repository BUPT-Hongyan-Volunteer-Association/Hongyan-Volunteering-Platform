{
  "name": "@hongyan/api",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "dev": "tsc && node --env-file=.env dist/main.js",
    "test:accounts": "node --test test/demo-accounts.test.mjs",
    "test:flow": "tsc && node --env-file=.env --test test/activity-flow.test.mjs",
    "test:students": "tsc && node --env-file=.env --test test/student-import.test.mjs",
    "db:seed": "node --env-file=.env scripts/seed.mjs",
    "test:pages": "node --env-file=.env --test test/pages.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "cookie": "1.1.1",
    "dotenv": "17.2.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@hongyan/contracts": "workspace:*",
    "@types/express": "5.0.6",
    "prisma": "7.10.1"
  }
}
